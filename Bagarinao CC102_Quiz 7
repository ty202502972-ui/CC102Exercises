#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>
using namespace std;

bool isPerfect(int n) {
    if (n < 2) return false;

    int sum = 1; // 1 is always a divisor

    for (int i = 2; i <= sqrt(n); i++) {
        if (n % i == 0) {
            sum += i;

            if (i != n / i)
                sum += n / i;
        }
    }

    return sum == n;
}

